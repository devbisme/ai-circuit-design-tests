	(text "USB-C RECEPTACLE (USB 2.0 HS ONLY, Rd=5.1k) + FT232H SYNC-FIFO BRIDGE (EEPROM sets FT245 sync mode)"
		(at 30.48 45.72 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "92e54eda-d202-4c6c-8f7c-72c95bbfbf33")
	)
	(text "LTC2290 DUAL 12-BIT 10 MSPS ADC (SENSE=VDD: 2 Vpp diff; MODE=2/3 VDD: 2's complement, DCS on)"
		(at 340.36 355.6 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "f8060a90-85d3-4316-a406-4e792e38c957")
	)
	(text "10 MHz SAMPLE CLOCK: X1 drives ADC directly (low jitter); FPGA receives a series-terminated copy on GBIN6"
		(at 220.98 505.46 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3ea4c765-2f31-4342-8944-f6c391dce152")
	)
	(text "iCE40HX4K FPGA: ADC capture > SDRAM buffer > FT232H upload. Bank3=ADC, Bank1=SDRAM data/ctrl, Bank0=SDRAM addr+misc, Bank2=FT232H"
		(at 535.94 45.72 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a39dcbca-dde9-4452-85e0-a01508446e4e")
	)
	(text "SDRAM 32 MB = 0.8 s at 2 ch x 10 MSPS x 16 b (spec needs 0.1 s)"
		(at 746.76 81.28 0)
		(effects
			(font
				(size 1.905 1.905)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5448014d-fcd5-465a-ab02-9dc8995dd573")
	)
	(text "FPGA CONFIG FLASH + PROGRAMMING HEADER"
		(at 746.76 266.7 0)
		(effects
			(font
				(size 1.905 1.905)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2729c259-822f-4d73-acf6-7b5a5ab3a84f")
	)
	(text "DESIGN NOTES / OPEN ITEMS (details in DESIGN_NOTES.md)"
		(at 279.4 63.5 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "89f240a8-6458-4060-8efc-80d7355659b9")
	)
	(text "3. DC-coupled only, fixed range. R3/R13 (953k) must be >= 200 V rated parts."
		(at 279.4 80.01 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left bottom)
		)
		(uuid "aabe2203-b4fc-424c-86a1-4b2467d90acf")
	)
	(text "5. ERC waivers: U6 PGOOD tied to GND per LM27762 datasheet; U9 WP#/HOLD# tied to +3V3 (single-SPI config)."
		(at 279.4 90.17 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left bottom)
		)
		(uuid "319194f2-f35a-4fb0-8ef1-86db95b580bc")
	)
	(text "6. Single GND net in schematic; partition analog/digital return currents at PCB layout."
		(at 279.4 95.25 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left bottom)
		)
		(uuid "64d5db74-bb38-4e83-9a73-8bb1f9458ca7")
	)
	(text "ANALOG FRONT END x2: BNC 1M||~14pF, /21 compensated divider (trim C20/C24 ~18pF w/ square wave), BAV99 clamp, 2-pole Sallen-Key buffer + FDA G=2 with Cf pole. FS=+/-10.5V, -3dB 1.65MHz"
		(at 30.48 372.11 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fdc5185d-82a6-4287-96bb-d5aef1dfdab9")
	)
	(text "2. Anti-alias: 3rd-order (SK f0 2.1MHz Q~1 + FDA pole 1.9MHz): -3dB 1.65MHz, -23dB at 5MHz, -36dB at 8MHz. Divider C2 loading included in trim."
		(at 279.4 74.93 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left bottom)
		)
		(uuid "9e7c7ada-45e8-470d-81b6-524afac32587")
	)
