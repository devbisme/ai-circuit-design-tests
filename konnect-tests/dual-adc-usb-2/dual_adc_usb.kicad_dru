(version 1)

(rule "konnect:F.Cu:clearance"
  (constraint clearance (min 0.15mm))
  (layer "F.Cu"))

(rule "konnect:F.Cu:track_width"
  (constraint track_width (min 0.15mm))
  (layer "F.Cu"))

(rule "konnect:B.Cu:clearance"
  (constraint clearance (min 0.15mm))
  (layer "B.Cu"))

(rule "konnect:B.Cu:track_width"
  (constraint track_width (min 0.15mm))
  (layer "B.Cu"))

(rule "konnect:In1.Cu:clearance"
  (constraint clearance (min 0.15mm))
  (layer "In1.Cu"))

(rule "konnect:In2.Cu:clearance"
  (constraint clearance (min 0.15mm))
  (layer "In2.Cu"))
