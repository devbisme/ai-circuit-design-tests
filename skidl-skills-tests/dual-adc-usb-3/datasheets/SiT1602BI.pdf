    <div class="modal renesas-exit-modal" modal-id="renesas-exit" role="dialog" aria-modal="true" aria-labelledby="renesas-exit-title" aria-describedby="renesas-exit-desc">
  <div class="modal__wrapper">
    <div class="modal__container renesas-exit-modal__container">
      <button type="button" class="modal__close renesas-exit-modal__close" aria-label="Close">
        <svg>
          <use xlink:href="#x"></use>
        </svg>
      </button>
      <h3 class="modal__title renesas-exit-modal__title" id="renesas-exit-title">You're now leaving SiTime.com</h3>
      <div class="renesas-exit-modal__body" id="renesas-exit-desc">
        <p class="renesas-exit-modal__description">
          You're being redirected to the Clocks & Timing pages on Renesas.com, where datasheets, documentation, and sample ordering remain available through late 2026.
        </p>
        <p class="renesas-exit-modal__description">
          For new designs, purchasing, and support, use the form below or email
          <a href="mailto:SalesClocks@sitime.com" class="renesas-exit-modal__email-link">SalesClocks@sitime.com</a>.
        </p>
        <p class="renesas-exit-modal__closing">
          Thank you for your patience.
        </p>
      </div>
      <div class="renesas-exit-modal__actions">
        <button type="button" class="renesas-exit-modal__btn renesas-exit-modal__btn--back">
          Go back
        </button>
        <a href="#" class="renesas-exit-modal__btn renesas-exit-modal__btn--continue" target="_blank" rel="noopener noreferrer">
          Continue
        </a>
      </div>
    </div>
  </div>
</div>

