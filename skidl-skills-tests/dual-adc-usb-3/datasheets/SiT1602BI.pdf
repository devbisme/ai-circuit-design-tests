            <div class="form-item form-item-email">
              <label class="form-required">Business Email</label>
            </div>
            <div class="form-item form-type-select form-item-industry">
              <div class="drop-down">
                <label for="industry" class="js-form-required form-required">Industry</label>
              </div>
            </div>
            <div class="form-item form-item-other-industry">
              <label for="edit-other-industry">Other Industry</label>
              <input data-drupal-selector="edit-other-industry" type="text" id="edit-other-industry" name="other-industry" value="" size="60" maxlength="255" class="form-text">
            </div>
            <div class="form-item form-type-select form-item-role">
              <div class="drop-down">
                <label for="subscribe-role">Role</label>
                <select name="subscribe-role" id="subscribe-role">
                  <option value="">Select Role</option>
                  <option value="Potential Customer">Potential Customer</option>
                  <option value="Current Customer">Current Customer</option>
                  <option value="SiTime Sales Partner">SiTime Sales Partner</option>
                  <option value="Investor">Investor</option>
                  <option value="Media/Analyst">Media/Analyst</option>
                  <option value="Student/Educator">Student/Educator</option>
                </select>
              </div>
            </div>
            <div class="form-checkbox">
              <input data-drupal-selector="edit-update-me-on-products-events-and-news-subscribe" type="checkbox" id="edit-update-me-on-products-events-and-news-subscribe" name="update_me_on_products_events_and_news_subscribe" value="1" class="form-checkbox">
              <label for="edit-update-me-on-products-events-and-news-subscribe" class="option">I would like to receive emails from SiTime about products, events, and special offers.</label>
            </div>

            <div class="form-checkbox">
              <input data-drupal-selector="edit-update-me-on-timing-essentials-learning-courses-subscribe" type="checkbox" id="edit-update-me-on-timing-essentials-learning-courses-subscribe" name="update_me_on_timing_essentials_learning_courses_subscribe" value="1" class="form-checkbox">
              <label for="edit-update-me-on-timing-essentials-learning-courses-subscribe" class="option">I would like to receive emails about learning opportunities from SiTime, including the Timing Essentials Learning Hub.</label>
            </div>

            <div class="form-checkbox">
              <input data-drupal-selector="edit-send-me-the-sitime-newsletter-4-6-maximum-per-year-subscribe" type="checkbox" id="edit-send-me-the-sitime-newsletter-4-6-maximum-per-year-subscribe" name="send_me_the_sitime_newsletter_4_6_maximum_per_year_subscribe" value="1" class="form-checkbox">
              <label for="edit-send-me-the-sitime-newsletter-4-6-maximum-per-year-subscribe" class="option">I would like to receive the SiTime newsletter (4-6 maximum per year).</label>
            </div>

            <div class="form-checkbox">
              <input data-drupal-selector="edit-i-have-read-and-accept-the-terms-of-use-and-privacy-policy-subscribe" type="checkbox" id="edit-i-have-read-and-accept-the-terms-of-use-and-privacy-policy-subscribe" name="i_have_read_and_accept_the_terms_of_use_and_privacy_policy_subscribe" value="1" class="form-checkbox required" required="required" aria-required="true">
              <label for="edit-i-have-read-and-accept-the-terms-of-use-and-privacy-policy-subscribe" class="option js-form-required form-required">I have read and accept the <a href="/terms-of-use">Terms of Use</a></label>
              <div class="description">
                <div id="edit-i-have-read-and-accept-the-terms-of-use-and-privacy-policy--description" class="webform-element-description">We process your personal information in accordance with our <a href="/privacy-policy">Privacy Policy</a>. You can manage your communication preferences in the <a href="https://go.sitime.com/Preference-Center.html" target="_blank">Preference Center</a>.</div>
              </div>
            </div>
            <div class="form-actions">
              <input class="form-submit" id="edit-actions-subscribe-form-submit" name="op" value="Submit" type="submit">
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

